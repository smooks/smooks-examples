                                             <xsd:sequence dfdl:initiatedContent="yes">
                                                <xsd:element dfdl:initiator="DOC"
                                                             dfdl:ref="ibmEdiFmt:EDISegmentFormat"
                                                             maxOccurs="1"
                                                             minOccurs="1"
                                                             name="DOC"
                                                             type="D03B:DOC-DocumentMessageDetails"/>
