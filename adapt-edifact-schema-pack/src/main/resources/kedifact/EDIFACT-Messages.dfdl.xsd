                                        maxOccurs="99"
                                        minOccurs="0"
                                        name="SegGrp-7">
                              <xsd:complexType>
                                 <xsd:sequence>
                                    <xsd:sequence dfdl:initiatedContent="yes">
                                       <xsd:element dfdl:initiator="MOA"
                                                    dfdl:ref="ibmEdiFmt:EDISegmentFormat"
                                                    maxOccurs="1"
                                                    minOccurs="1"
                                                    name="MOA"
                                                    type="D03B:MOA-MonetaryAmount"/>
