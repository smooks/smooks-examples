                                                             dfdl:occursCountKind="parsed"
                                                             dfdl:ref="ibmEdiFmt:EDISegmentFormat"
                                                             maxOccurs="1"
                                                             minOccurs="0"
                                                             name="LOC"
                                                             type="D03B:LOC-PlaceLocationIdentification"/>
                                                <xsd:element dfdl:initiator="DTM"
                                                             dfdl:occursCountKind="parsed"
                                                             dfdl:ref="ibmEdiFmt:EDISegmentFormat"
                                                             maxOccurs="10"
                                                             minOccurs="0"
                                                             name="DTM"
                                                             type="D03B:DTM-DateTimePeriod"/>
                                             </xsd:sequence>
                                          </xsd:sequence>
                                       </xsd:complexType>
