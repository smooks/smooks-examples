                                          </xsd:sequence>
                                       </xsd:complexType>
                                    </xsd:element>
                                    <xsd:element dfdl:occursCountKind="parsed"
                                                 maxOccurs="5"
                                                 minOccurs="0"
                                                 name="SegGrp-12">
